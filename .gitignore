# Environnement Python et caches
scripts/.venv/
__pycache__/
*.pyc
*.pyo

# Données binaires lourdes (régénérables via le pipeline)
# audio/visuals : symlinks vers le disque media (cf. scripts/paths.py)
library/audio
library/stems
library/visuals

# Artefacts générés (régénérables via groove.py / visualize.py / to_xrns.py)
library/grooves
library/renoise

# État de session Obsidian (config conservée, workspace ignoré)
.obsidian/workspace.json
.obsidian/workspace-mobile.json

# macOS
.DS_Store

# Draft Digitakt : MIDI par pattern (régénérable via digitakt.py)
library/digitakt/*/

# Front : dépendances et build
web/node_modules/
web/dist/

# Manuel Elektron (PDF tiers, sert le front en local via /api/manual)
refs/*.pdf

# IDE JetBrains
.idea/
