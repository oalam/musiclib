{
  "id": "layer_blend",
  "treatment": "variations",
  "label": "Kick + couche dosee",
  "description": "8 variantes : le kick source tient le corps, la couche C1 (clic, top, autre kick) passe de -24 dB (tranche 1, a peine) a -6 dB (tranche 8), attaques calees, couche filtree au-dessus de 1 kHz pour ne pas doubler le grave.",
  "settings": {"bpm": 150, "length_beats": 1, "slices": 1, "jitter": 0.3},
  "chains": [
    {
      "name": "Kick",
      "mute": false,
      "gain_db": 0,
      "devices": [
        {"type": "highpass", "params": {"cutoff_frequency_hz": 25}, "bypass": false}
      ]
    },
    {
      "name": "Couche",
      "mute": false,
      "gain_db": -24,
      "gain_db_end": -6,
      "layer": 1,
      "devices": [
        {"type": "filter", "params": {"mode": 3, "cutoff_hz": 1000, "resonance": 0, "drive": 1}, "bypass": false}
      ]
    }
  ],
  "master": [
    {"type": "limiter", "params": {"threshold_db": -1, "release_ms": 100}, "bypass": false}
  ],
  "output_peak_db": -1
}
