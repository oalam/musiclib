{
  "id": "rumble_tints",
  "treatment": "variations",
  "label": "Kick + rumble dose",
  "description": "8 variantes kick + rumble en un coup : le rumble passe de -30 dB (a peine) a -12 dB (bien present) et le drive du kick de 2 a 8 dB. Le kick reste au meme niveau, la queue grave varie.",
  "settings": {"bpm": 150, "length_beats": 1, "slices": 1, "jitter": 0.3},
  "chains": [
    {
      "name": "Kick",
      "mute": false,
      "gain_db": 0,
      "devices": [
        {"type": "distortion", "params": {"drive_db": 2}, "params_end": {"drive_db": 8}, "bypass": false},
        {"type": "highpass", "params": {"cutoff_frequency_hz": 25}, "bypass": false}
      ]
    },
    {
      "name": "Rumble",
      "mute": false,
      "gain_db": 0,
      "devices": [
        {"type": "reverb", "params": {"room_size": 0.85, "damping": 0.6, "wet_level": 1, "dry_level": 0, "width": 0}, "bypass": false},
        {"type": "lowpass", "params": {"cutoff_frequency_hz": 220}, "bypass": false},
        {"type": "distortion", "params": {"drive_db": 14}, "bypass": false},
        {"type": "lowpass", "params": {"cutoff_frequency_hz": 160}, "bypass": false},
        {"type": "highpass", "params": {"cutoff_frequency_hz": 30}, "bypass": false},
        {"type": "duck", "params": {"depth_db": 30, "attack_ms": 2, "hold_ms": 30, "release_ms": 220}, "bypass": false},
        {"type": "width", "params": {"width": 0}, "bypass": false},
        {"type": "gain", "params": {"gain_db": -30}, "params_end": {"gain_db": -12}, "bypass": false}
      ]
    }
  ],
  "master": [
    {"type": "limiter", "params": {"threshold_db": -1, "release_ms": 100}, "bypass": false}
  ],
  "output_peak_db": -1
}
